+/* mlDIAG-GUEST: targeted guest-memory provenance probe for the NFS MW crash.
+ *
+ * The failing host address 0x71B449AB6A corresponds to guest address
+ * 0xB449AB6A when the WoW64 window is based at 0x7100000000.
+ * Keep this probe deliberately narrow so it does not recreate the historical
+ * multi-million-line VM log storms.
+ */
+#define IOS_DIAG_WOW_HOST_BASE   0x7100000000ULL
+#define IOS_DIAG_WOW_HOST_END    0x7200000000ULL
+#define IOS_DIAG_GUEST_BEGIN     0xB0000000ULL
+#define IOS_DIAG_GUEST_END       0xB8000000ULL
+#define IOS_DIAG_GUEST_TARGET    0xB449AB6AULL
+
+static int ios_diag_host_guest( UINT64 host, UINT64 *guest )
+{
+    if (host < IOS_DIAG_WOW_HOST_BASE || host >= IOS_DIAG_WOW_HOST_END) return 0;
+    if (guest) *guest = host - IOS_DIAG_WOW_HOST_BASE;
+    return 1;
+}
+
+static int ios_diag_guest_overlap( UINT64 host, SIZE_T size, UINT64 *guest )
+{
+    UINT64 g, end;
+    if (!ios_diag_host_guest( host, &g )) return 0;
+    end = g + (UINT64)size;
+    if (end < g) end = UINT64_MAX;
+    if (guest) *guest = g;
+    return g < IOS_DIAG_GUEST_END && end > IOS_DIAG_GUEST_BEGIN;
+}
+
